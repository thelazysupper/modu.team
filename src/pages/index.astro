            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-slate-200/80 bg-[#fbfcfd] text-slate-500">
                  <th class="py-3 px-4 font-medium">Query</th>
                  <th class="py-3 px-4 font-medium">Intent</th>
                  <th class="py-3 px-4 font-medium">AEO Visibility</th>
                  <th class="py-3 px-4 font-medium">SEO Visibility</th>
                  <th class="py-3 px-4 font-medium">Status</th>
                  <th class="py-3 px-4 font-medium text-right">Gap</th>
                  <th class="py-3 px-4 font-medium text-right"></th>
                </tr>
              </thead>
              <tbody id="aeo-seo-table-body" class="divide-y divide-slate-200/70"></tbody>
            </table>
          </div>
        </div>

        <!-- 4 SUMMARY CARDS UNDERNEATH -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          <div class="p-4 rounded-xl border border-slate-200/80 bg-[#fbfcfd] space-y-1">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Tracked Queries</span>
              <span class="text-[11px] text-slate-400">Coverage</span>
            </div>
            <div id="as-sum-count" class="text-lg font-bold tabular-nums text-slate-900">0</div>
            <div id="as-sum-cited" class="text-[11px] text-slate-400">0 cited in AI</div>
          </div>

          <div class="p-4 rounded-xl border border-slate-200/80 bg-[#fbfcfd] space-y-1">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Avg. AEO Visibility</span>
              <span class="text-[11px] text-slate-400">AI Engines</span>
            </div>
            <div id="as-sum-aeo" class="text-lg font-bold tabular-nums text-slate-900">0.0%</div>
            <div class="text-[11px] text-slate-400">Answer engine share</div>
          </div>

          <div class="p-4 rounded-xl border border-slate-200/80 bg-[#fbfcfd] space-y-1">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Avg. SEO Visibility</span>
              <span class="text-[11px] text-slate-400">Search</span>
            </div>
            <div id="as-sum-seo" class="text-lg font-bold tabular-nums text-slate-900">0.0%</div>
            <div id="as-sum-rank" class="text-[11px] text-slate-400">Avg. rank: —</div>
          </div>

          <div class="p-4 rounded-xl border border-slate-200/80 bg-[#fbfcfd] space-y-1">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>AEO vs. SEO Gap</span>
              <span class="text-[11px] text-slate-400">Delta</span>
            </div>
            <div id="as-sum-gap" class="text-lg font-bold tabular-nums text-slate-900">0.0%</div>
            <div id="as-sum-gap-sub" class="text-[11px] text-slate-400">Parity</div>
          </div>
        </div>
      </section>

      <!-- VIEW 3: OTHER APP SHELLS -->
      <section id="view-app-detail" class="hidden max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200/80">
          <div class="flex items-center gap-2 text-xs">
            <button onclick="openHub()" class="text-slate-500 hover:text-slate-900 font-medium flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              <span>Apps</span>
            </button>
            <span class="text-slate-300">/</span>
            <span id="active-app-breadcrumb" class="font-semibold text-slate-900"></span>
          </div>

          <span id="active-app-status" class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700"></span>
        </div>

        <div class="space-y-1">
          <h2 id="active-app-title" class="text-xl font-bold tracking-tight text-slate-900"></h2>
          <p id="active-app-desc" class="text-sm text-slate-500"></p>
        </div>

        <div class="rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center min-h-[340px]">
          <div class="w-12 h-12 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-slate-700 mb-3 card-shadow">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="1.6"/>
            </svg>
          </div>
          <div class="text-sm font-semibold text-slate-900" id="active-app-empty-title">Ready to build</div>
          <p class="text-xs text-slate-500 max-w-sm mt-1">
            This app workspace is intentionally empty with no mock content.
          </p>
        </div>
      </section>

      <!-- VIEW 4: GENERIC SECTION -->
      <section id="view-generic-section" class="hidden max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="space-y-1">
          <h1 id="generic-section-title" class="text-2xl font-bold tracking-tight text-slate-900"></h1>
          <p id="generic-section-desc" class="text-sm text-slate-500"></p>
        </div>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center min-h-[300px]">
          <p class="text-xs text-slate-500">Empty view — ready to configure.</p>
        </div>
      </section>

    </main>
  </div>

  <script is:inline set:html={appJs}></script>
</body>
</html>
