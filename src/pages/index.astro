---
import fs from "node:fs";
import path from "node:path";
import "../styles/app.css";
const appJs = fs.readFileSync(path.resolve("app.js"), "utf8");
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ||
  process.env.PUBLIC_SUPABASE_URL ||
  process.env.NEXT_PUBLIC_SUPABASE_URL ||
  process.env.SUPABASE_URL ||
  "";
const supabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
  process.env.PUBLIC_SUPABASE_ANON_KEY ||
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY ||
  process.env.SUPABASE_ANON_KEY ||
  "";
const supabaseConfigScript = `window.__MODU_SUPABASE__ = ${JSON.stringify({ url: supabaseUrl, anonKey: supabaseAnonKey })};`;
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Modu — Marketing Workspace</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script is:inline set:html={supabaseConfigScript}></script>
</head>
<body class="bg-white text-slate-900 antialiased m-0 p-0">
  <!-- LOGIN SCREEN -->
  <div id="auth-screen" class="min-h-screen bg-[#fbfcfd] flex items-center justify-center p-6">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200/80 bg-white p-7 card-shadow space-y-6 animate-fade">
      <div class="space-y-2">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
              <rect x="2" y="2" width="5" height="5" rx="1"/>
              <rect x="9" y="2" width="5" height="5" rx="1" opacity="0.5"/>
              <rect x="2" y="9" width="5" height="5" rx="1" opacity="0.5"/>
              <rect x="9" y="9" width="5" height="5" rx="1"/>
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight text-slate-900">Modu</span>
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200/60">Workspace</span>
        </div>
        <h1 id="auth-title" class="text-xl font-bold tracking-tight text-slate-900 pt-1">Sign in</h1>
        <p id="auth-subtitle" class="text-xs text-slate-500">Enter your credentials to access your marketing workspace.</p>
      </div>

      <form onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label for="login-username" class="block text-[11px] font-medium text-slate-600 mb-1">Email</label>
          <input
            id="login-username"
            type="email"
            autocomplete="username"
            placeholder="name@company.com"
            class="w-full h-9 px-3 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
          />
        </div>

        <div>
          <label for="login-password" class="block text-[11px] font-medium text-slate-600 mb-1">Password</label>
          <div class="relative">
            <input
              id="login-password"
              type="password"
              autocomplete="current-password"
              placeholder="Enter password"
              class="w-full h-9 pl-3 pr-14 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
            />
            <button
              type="button"
              onclick="toggleLoginPasswordVisibility()"
              id="login-pw-toggle"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[11px] font-medium text-slate-400 hover:text-slate-700"
            >
              Show
            </button>
          </div>
        </div>

        <div id="login-error" class="hidden rounded-lg bg-rose-50 border border-rose-200/80 px-3 py-2 text-xs text-rose-600">
          Invalid email or password.
        </div>

        <div id="login-info" class="hidden rounded-lg bg-emerald-50 border border-emerald-200/80 px-3 py-2 text-xs text-emerald-700"></div>

        <button
          id="login-submit-btn"
          type="button"
          onclick="handleLogin(event)"
          class="w-full h-9 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium transition-colors"
        >
          Sign in
        </button>
      </form>

      <div class="pt-2 border-t border-slate-200/70 text-center">
        <button type="button" id="auth-mode-toggle" onclick="toggleAuthMode()" class="text-[11px] text-slate-500 hover:text-slate-900 transition-colors">
          Don't have an account? <span class="font-semibold text-slate-900 underline underline-offset-2">Create account</span>
        </button>
      </div>
    </div>
  </div>

  <div id="app-shell" class="hidden flex w-full min-h-screen flex-col md:flex-row">

    <!-- LEFT SIDEBAR -->
    <aside id="app-sidebar" class="w-full md:w-60 shrink-0 bg-[#fbfcfd] border-b md:border-b-0 md:border-r border-slate-200/80 flex flex-col justify-between md:fixed md:top-0 md:left-0 md:h-screen md:z-30 md:overflow-y-auto transition-all duration-200">
      <div>
        <div id="sidebar-brand-header" class="h-14 px-4 border-b border-slate-200/70 flex items-center justify-between gap-2">
          <button onclick="openHub()" id="sidebar-brand-btn" class="flex items-center gap-2.5 text-left focus:outline-none min-w-0">
            <div class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
                <rect x="2" y="2" width="5" height="5" rx="1"/>
                <rect x="9" y="2" width="5" height="5" rx="1" opacity="0.5"/>
                <rect x="2" y="9" width="5" height="5" rx="1" opacity="0.5"/>
                <rect x="9" y="9" width="5" height="5" rx="1"/>
              </svg>
            </div>
            <span class="sidebar-label text-sm font-semibold tracking-tight text-slate-900 truncate">Modu</span>
          </button>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="sidebar-label text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200/60">Workspace</span>
            <button
              id="sidebar-toggle-btn"
              onclick="toggleSidebar()"
              title="Collapse sidebar"
              class="w-7 h-7 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition-colors"
            >
              <svg id="sidebar-toggle-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="sidebar-nav-wrap" class="p-3 space-y-5">
          <div class="space-y-0.5">
            <div class="sidebar-label px-2.5 pb-1.5 text-[11px] font-medium uppercase tracking-wider text-slate-400">
              Menu
            </div>
            <button onclick="openHome()" id="nav-home" title="Home" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-100/70 hover:text-slate-900 transition-colors">
              <span class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                <span class="sidebar-label">Home</span>
              </span>
            </button>
            <button onclick="openHub()" id="nav-hub" title="Apps" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs font-medium bg-slate-100 text-slate-900 transition-colors">
              <span class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" stroke-width="1.8"/>
                  <rect x="14" y="3" width="7" height="7" rx="1.5" stroke-width="1.8"/>
                  <rect x="3" y="14" width="7" height="7" rx="1.5" stroke-width="1.8"/>
                  <rect x="14" y="14" width="7" height="7" rx="1.5" stroke-width="1.8"/>
                </svg>
                <span class="sidebar-label">Apps</span>
              </span>
              <span id="sidebar-app-count" class="sidebar-label text-[11px] text-slate-500">6</span>
            </button>

            <button onclick="openSection('wishlist')" id="nav-wishlist" title="Wishlist" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-100/70 hover:text-slate-900 transition-colors">
              <span class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4v16m8-8H4"/>
                </svg>
                <span class="sidebar-label">Wishlist</span>
              </span>
            </button>

            <button onclick="openSection('settings')" id="nav-settings" title="Settings" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-100/70 hover:text-slate-900 transition-colors">
              <span class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                <span class="sidebar-label">Settings</span>
              </span>
            </button>
          </div>

          <div class="space-y-0.5 pt-3 border-t border-slate-200/70">
            <div class="sidebar-label px-2.5 pb-1.5 text-[11px] font-medium uppercase tracking-wider text-slate-400">
              Apps
            </div>
            <div id="sidebar-apps-list" class="space-y-0.5"></div>
          </div>
        </div>
      </div>

      <div class="p-3 border-t border-slate-200/70">
        <div id="sidebar-footer-row" class="px-2.5 py-1.5 text-[11px] text-slate-400 flex items-center justify-between gap-2">
          <span class="sidebar-label truncate">Modu Workspace</span>
          <button onclick="handleLogout()" title="Sign out" class="sidebar-label text-[11px] font-medium text-slate-500 hover:text-slate-900 transition-colors shrink-0">Sign out</button>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main id="app-main" class="flex-1 min-w-0 bg-white p-6 lg:p-8 md:ml-60 transition-all duration-200">

      <!-- VIEW 0: CUSTOMIZABLE HOME DASHBOARD -->
      <section id="view-home" class="hidden max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-200/80">
          <div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900">Home</h1>
            <p class="text-xs text-slate-500 mt-0.5">Customize your workspace dashboard with any charts, tables, and KPIs.</p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <div class="flex items-center gap-1.5 h-8 px-2.5 rounded-lg border border-slate-200 bg-white text-xs">
              <span class="text-slate-400">Year:</span>
              <select id="home-year-select" onchange="requestYearChange(this.value, this)" class="bg-transparent text-slate-900 font-medium text-xs focus:outline-none cursor-pointer">
                <option value="2025">2025</option>
                <option value="2026" selected>2026</option>
                <option value="2027">2027</option>
              </select>
            </div>

            <div class="flex items-center gap-1.5 h-8 px-2.5 rounded-lg border border-slate-200 bg-white text-xs">
              <span class="text-slate-400">Grid:</span>
              <select id="home-grid-cols" onchange="setHomeGridCols(this.value)" class="bg-transparent text-slate-900 font-medium text-xs focus:outline-none cursor-pointer">
                <option value="2">2 Columns</option>
                <option value="3" selected>3 Columns</option>
              </select>
            </div>

            <button
              id="home-reset-btn"
              type="button"
              onclick="resetHomeDashboard()"
              class="hidden h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-medium transition-colors"
            >
              Reset Default
            </button>

            <button
              id="home-edit-toggle-btn"
              type="button"
              onclick="toggleHomeEditMode()"
              class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium flex items-center gap-1.5 transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              <span id="home-edit-toggle-label">Edit Layout</span>
            </button>

            <button
              type="button"
              onclick="toggleHomeWidgetPicker()"
              class="h-8 px-3.5 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium flex items-center gap-1.5 transition-colors"
            >
              <span>+ Add Widget</span>
            </button>
          </div>
        </div>

        <div id="home-widget-picker" class="hidden rounded-2xl border border-slate-200 bg-[#fbfcfd] p-5 space-y-4 animate-fade">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200/80">
            <div>
              <h3 class="text-sm font-semibold text-slate-900">Add Charts, Tables &amp; KPIs</h3>
              <p class="text-[11px] text-slate-500">Click any widget to add it to your Home grid. You can resize or drag-reorder widgets anytime.</p>
            </div>
            <button type="button" onclick="toggleHomeWidgetPicker(false)" class="text-xs text-slate-400 hover:text-slate-700">✕ Close</button>
          </div>
          <div id="home-widget-catalog" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
        </div>

        <div id="home-empty-state" class="hidden rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center min-h-[260px]">
          <div class="text-sm font-semibold text-slate-900">Your Home dashboard is empty</div>
          <p class="text-xs text-slate-500 max-w-sm mt-1 mb-4">Add charts, tables, and KPIs from across your workspace to build your custom overview.</p>
          <button type="button" onclick="toggleHomeWidgetPicker(true)" class="h-8 px-3.5 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium">+ Add Widget</button>
        </div>

        <div id="home-widgets-grid" ondragover="onHomeCanvasDragOver(event)" ondrop="onHomeCanvasDrop(event)" class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-stretch"></div>

        <div id="home-canvas-dock" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-40 max-w-[92vw] rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-md shadow-2xl px-3 py-2 flex items-center gap-2 overflow-x-auto animate-fade">
          <span class="text-[11px] font-semibold text-slate-500 px-1.5 shrink-0">Drag or click to add:</span>
          <div id="home-dock-items" class="flex items-center gap-1.5 shrink-0"></div>
          <div class="w-px h-5 bg-slate-200 mx-0.5 shrink-0"></div>
          <button type="button" onclick="toggleHomeWidgetPicker()" class="h-7 px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-[11px] font-medium text-slate-800 shrink-0 transition-colors">All Widgets</button>
          <button type="button" onclick="toggleHomeEditMode(false)" class="h-7 px-3 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-[11px] font-medium shrink-0 transition-colors">Done</button>
        </div>
      </section>

      <!-- VIEW 1: APPS DIRECTORY -->
      <section id="view-hub" class="max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="space-y-1.5">
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">Apps</h1>
          <p class="text-sm text-slate-500 max-w-2xl leading-relaxed">
            Overview of marketing apps and tools in your workspace. Select an app below to open it, or add new app ideas under Wishlist in the menu.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <div class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                id="search-input"
                type="text"
                oninput="renderCards()"
                placeholder="Search by name or description ..."
                class="w-full h-9 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400 transition-colors"
              />
            </div>

            <div class="relative">
              <button
                onclick="cycleStatusFilter()"
                id="filter-btn"
                title="Filter by status"
                class="h-9 px-2.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 flex items-center gap-1.5 text-xs transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16M8 4v4m8 2v4m-6 2v4"/>
                </svg>
                <span id="filter-label" class="hidden sm:inline text-xs font-medium text-slate-600">All</span>
              </button>
            </div>
          </div>

          <button
            onclick="toggleAppGroupForm(true)"
            class="h-9 px-3.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium flex items-center gap-1.5 transition-colors"
          >
            <span>+ New Group</span>
          </button>
        </div>

        <div id="app-group-form" class="hidden rounded-2xl border border-slate-200 bg-[#fbfcfd] p-5 space-y-4 animate-fade">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200/80">
            <h3 id="app-group-form-title" class="text-sm font-semibold text-slate-900">New App Group</h3>
            <button onclick="toggleAppGroupForm(false)" class="text-xs text-slate-400 hover:text-slate-700">✕ Close</button>
          </div>

          <input type="hidden" id="ag-edit-id" value="" />

          <div class="space-y-3">
            <div class="max-w-sm">
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Group Name</label>
              <input
                id="ag-name"
                type="text"
                placeholder="e.g. Growth, Analytics, Sales..."
                onkeydown="if(event.key==='Enter'){event.preventDefault();saveAppGroup();}"
                class="w-full h-9 px-3 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-[11px] font-medium text-slate-600">Apps in Group</label>
              <div id="ag-apps-picker" class="flex flex-wrap gap-1.5"></div>
            </div>
          </div>

          <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200/70">
            <button onclick="toggleAppGroupForm(false)" class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-600">
              Cancel
            </button>
            <button onclick="saveAppGroup()" class="h-8 px-4 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium">
              Save Group
            </button>
          </div>
        </div>

        <div id="apps-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></div>
      </section>

      <!-- VIEW 1B: APP GROUP UNDERPAGE -->
      <section id="view-app-group" class="hidden max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-200/80">
          <div class="flex items-center gap-2 text-xs">
            <button onclick="openHub()" class="text-slate-500 hover:text-slate-900 font-medium flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              <span>Apps</span>
            </button>
            <span class="text-slate-300">/</span>
            <span id="group-view-breadcrumb" class="font-semibold text-slate-900">Group</span>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="group-view-edit-btn"
              class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700 transition-colors"
            >
              Edit Group
            </button>
            <button
              id="group-view-delete-btn"
              class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-xs font-medium text-slate-500 transition-colors"
            >
              Delete
            </button>
          </div>
        </div>

        <div class="space-y-1">
          <h2 id="group-view-title" class="text-xl font-bold tracking-tight text-slate-900">Group</h2>
          <p id="group-view-subtitle" class="text-xs text-slate-500"></p>
        </div>

        <div id="group-apps-empty" class="hidden rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center min-h-[220px]">
          <div class="text-sm font-semibold text-slate-900">No apps in this group yet</div>
          <p class="text-xs text-slate-500 max-w-sm mt-1 mb-4">
            Click Edit Group above to add apps to this group.
          </p>
        </div>

        <div id="group-apps-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></div>
      </section>

