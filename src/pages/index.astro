          <div id="wishlist-status-filters" class="flex flex-wrap items-center gap-1.5">
            <button type="button" onclick="setWishlistStatusFilter('all')" data-wish-filter="all" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0f172a] text-white">All</button>
            <button type="button" onclick="setWishlistStatusFilter('Requested')" data-wish-filter="Requested" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white border border-slate-200 text-slate-600 hover:bg-slate-50">Requested</button>
            <button type="button" onclick="setWishlistStatusFilter('Planned')" data-wish-filter="Planned" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white border border-slate-200 text-slate-600 hover:bg-slate-50">Planned</button>
            <button type="button" onclick="setWishlistStatusFilter('In Progress')" data-wish-filter="In Progress" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white border border-slate-200 text-slate-600 hover:bg-slate-50">In Progress</button>
            <button type="button" onclick="setWishlistStatusFilter('Shipped')" data-wish-filter="Shipped" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white border border-slate-200 text-slate-600 hover:bg-slate-50">Shipped</button>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="wishlist-search"
              type="text"
              placeholder="Search wishlist..."
              oninput="renderWishlistView()"
              class="h-8 w-44 sm:w-56 px-3 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
            />
            <select id="wishlist-sort" onchange="renderWishlistView()" class="h-8 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:border-slate-400">
              <option value="votes">Most Upvoted</option>
              <option value="newest">Newest</option>
              <option value="priority">Priority</option>
            </select>
          </div>
        </div>

        <div id="wishlist-empty-state" class="hidden rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center">
          <p class="text-sm font-semibold text-slate-800">No wishlist items match</p>
          <p class="text-xs text-slate-500 mt-1 mb-4">Add a new app proposal or adjust your filters.</p>
          <button onclick="toggleWishlistForm(true)" class="h-8 px-3.5 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium">+ Add Wish</button>
        </div>

        <div id="wishlist-grid" class="space-y-3"></div>
      </section>

      <!-- VIEW 4: GENERIC SECTION -->
      <section id="view-generic-section" class="hidden max-w-6xl mx-auto space-y-6 animate-fade">
        <div class="space-y-1">
          <h1 id="generic-section-title" class="text-2xl font-bold tracking-tight text-slate-900"></h1>
          <p id="generic-section-desc" class="text-sm text-slate-500"></p>
        </div>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-[#fbfcfd] p-12 flex flex-col items-center justify-center text-center min-h-[300px]">
          <p class="text-xs text-slate-500">Empty view — ready to configure.</p>
        </div>
      </section>

    </main>
  </div>

  <div id="lead-detail-drawer" onclick="if(event.target===this) closeLeadDrawer()" style="width:100vw;height:100vh;" class="hidden fixed inset-0 z-50 w-screen h-screen bg-slate-900/45 backdrop-blur-[2px] flex justify-end">
    <aside class="w-full max-w-md h-full bg-white shadow-2xl border-l border-slate-200 flex flex-col overflow-hidden animate-fade">
      <div class="flex items-start justify-between gap-3 px-6 py-4 border-b border-slate-200/80 bg-[#fbfcfd]">
        <div class="flex items-center gap-3 min-w-0">
          <div id="ld-header-logo" class="w-10 h-10 rounded-xl border border-slate-200 bg-white flex items-center justify-center overflow-hidden shrink-0"></div>
          <div class="min-w-0">
            <h3 id="ld-header-title" class="text-sm font-bold text-slate-900 truncate">Lead Details</h3>
            <a id="ld-header-website" href="#" target="_blank" rel="noopener noreferrer" class="hidden text-[11px] text-slate-500 hover:text-slate-900 underline underline-offset-2 truncate block mt-0.5"></a>
          </div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button id="ld-edit-toggle-btn" type="button" onclick="toggleLeadDrawerEditMode()" title="Edit lead" class="w-7 h-7 rounded-lg border border-transparent hover:border-slate-200 hover:bg-white text-slate-500 hover:text-slate-900 flex items-center justify-center transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L16.875 4.5" />
            </svg>
          </button>
          <button type="button" onclick="closeLeadDrawer()" class="w-7 h-7 rounded-lg text-xs text-slate-400 hover:text-slate-700 hover:bg-white flex items-center justify-center transition-colors">✕</button>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-6">
        <input type="hidden" id="ld-id" value="" />

        <div id="ld-view-mode" class="space-y-4">
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-slate-200/80 bg-[#fbfcfd] p-3">
              <div class="text-[10px] font-medium uppercase tracking-wider text-slate-400">Deal Value</div>
              <div id="ld-view-value" class="text-base font-bold tabular-nums text-slate-900 mt-1">—</div>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-[#fbfcfd] p-3">
              <div class="text-[10px] font-medium uppercase tracking-wider text-slate-400">Stage</div>
              <div id="ld-view-stage" class="mt-1.5"></div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200/80 bg-white divide-y divide-slate-100">
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="text-xs text-slate-500">Channel</span>
              <span id="ld-view-channel" class="text-xs font-medium text-slate-900"></span>
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="text-xs text-slate-500">ERP-system</span>
              <span id="ld-view-erp" class="text-xs font-medium text-slate-900">—</span>
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="text-xs text-slate-500">Other Integration</span>
              <span id="ld-view-integration" class="text-xs font-medium text-slate-900">—</span>
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="text-xs text-slate-500">Date Added</span>
              <span id="ld-view-created" class="text-xs font-medium tabular-nums text-slate-900">—</span>
            </div>
            <div id="ld-view-won-row" class="hidden flex items-center justify-between gap-3 px-4 py-3 bg-emerald-50/40">
              <span class="text-xs font-medium text-emerald-700">Won Date</span>
              <span id="ld-view-won" class="text-xs font-semibold tabular-nums text-emerald-800">—</span>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200/80 bg-[#fbfcfd] p-4 space-y-1.5">
            <div class="text-[11px] font-semibold text-slate-700">Notes</div>
            <p id="ld-view-notes" class="text-xs text-slate-600 whitespace-pre-wrap leading-relaxed">No notes added.</p>
          </div>
        </div>

        <div id="ld-edit-mode" class="hidden space-y-4">
          <div class="rounded-xl border border-slate-200/80 bg-[#fbfcfd] p-3.5 space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <label class="text-[11px] font-semibold text-slate-700">Website &amp; Logo</label>
              <span id="ld-fetch-status" class="hidden text-[10px] text-slate-500"></span>
            </div>
            <div class="flex items-center gap-2">
              <input
                id="ld-website"
                type="url"
                placeholder="https://company.com"
                onkeydown="if(event.key==='Enter'){event.preventDefault();fetchLeadWebsiteLogo();}"
                oninput="syncLeadDrawerHeaderPreview()"
                class="flex-1 min-w-0 h-8 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
              />
              <button id="ld-fetch-logo-btn" type="button" onclick="fetchLeadWebsiteLogo()" class="h-8 px-3 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-[11px] font-medium shrink-0 transition-colors">Fetch Logo</button>
            </div>
            <div>
              <label class="block text-[10px] font-medium text-slate-500 mb-1">Logo URL</label>
              <input
                id="ld-logo"
                type="url"
                placeholder="Auto-filled from website or paste image URL"
                oninput="syncLeadDrawerHeaderPreview()"
                class="w-full h-8 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">Company Name</label>
            <input id="ld-company" type="text" oninput="syncLeadDrawerHeaderPreview()" class="w-full h-9 px-3 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Stage</label>
              <select id="ld-stage" class="w-full h-9 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400"></select>
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Value (NOK)</label>
              <input id="ld-value" type="number" min="0" step="any" placeholder="0" class="w-full h-9 px-3 text-xs tabular-nums bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">Channel</label>
            <select id="ld-channel" class="w-full h-9 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400"></select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">ERP-system</label>
              <select id="ld-erp" class="w-full h-9 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400"></select>
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Other Integration</label>
              <select id="ld-integration" class="w-full h-9 px-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400"></select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Date Added</label>
              <input id="ld-created-date" type="date" class="w-full h-9 px-2.5 text-xs tabular-nums bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-1">Won Date</label>
              <input id="ld-won-date" type="date" class="w-full h-9 px-2.5 text-xs tabular-nums bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">Notes</label>
            <textarea id="ld-notes" rows="3" placeholder="Add context, next steps, or key contacts..." class="w-full p-2.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400"></textarea>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between gap-2 px-6 py-4 border-t border-slate-200/80 bg-[#fbfcfd]">
        <button type="button" onclick="deleteLeadFromDrawer()" class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-red-50 hover:text-red-700 hover:border-red-200 text-xs font-medium text-slate-600 transition-colors">Delete</button>
        <div id="ld-footer-view" class="flex items-center gap-2">
          <button type="button" onclick="toggleLeadDrawerEditMode(true)" class="h-8 px-3.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700 transition-colors">Edit</button>
          <button type="button" onclick="closeLeadDrawer()" class="h-8 px-4 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium transition-colors">Close</button>
        </div>
        <div id="ld-footer-edit" class="hidden flex items-center gap-2">
          <button type="button" onclick="toggleLeadDrawerEditMode(false)" class="h-8 px-3.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700 transition-colors">Cancel</button>
          <button type="button" onclick="saveLeadFromDrawer()" class="h-8 px-4 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium transition-colors">Save Changes</button>
        </div>
      </div>
    </aside>
  </div>

  <input type="file" id="csv-file-input" accept=".csv,text/csv" class="hidden" onchange="handleCsvFileSelected(event)" />

  <div id="csv-import-modal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-[2px] flex items-center justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-slate-200 bg-white shadow-xl overflow-hidden animate-fade">
      <div class="flex items-start justify-between gap-3 px-6 py-4 border-b border-slate-200/80 bg-[#fbfcfd]">
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-slate-900">Confirm CSV Import &amp; Data Sync</h3>
            <span id="csv-modal-target-badge" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200/80"></span>
          </div>
          <p id="csv-modal-file-meta" class="text-[11px] text-slate-500 mt-0.5"></p>
        </div>
        <button type="button" onclick="declineCsvImport()" class="text-xs text-slate-400 hover:text-slate-700">✕</button>
      </div>

      <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
        <div id="csv-sync-summary" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5"></div>

        <div id="csv-sync-notes" class="rounded-xl border border-slate-200/80 bg-slate-50/70 p-3 text-[11px] text-slate-600 space-y-1"></div>

        <div class="rounded-xl border border-slate-200/80 overflow-hidden">
          <div class="px-3.5 py-2 bg-[#fbfcfd] border-b border-slate-200/80 flex items-center justify-between text-[11px] font-medium text-slate-600">
            <span>Preview of synced records</span>
            <span id="csv-preview-count" class="text-slate-400 tabular-nums"></span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[11px]">
              <thead id="csv-preview-head" class="bg-slate-50/80 text-slate-500 border-b border-slate-200/70"></thead>
              <tbody id="csv-preview-body" class="divide-y divide-slate-200/60"></tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-200/80 bg-[#fbfcfd]">
        <p class="text-[11px] text-slate-500">Review the changes above and choose whether to accept and sync or decline.</p>
        <div class="flex items-center gap-2">
          <button
            id="csv-decline-btn"
            type="button"
            onclick="declineCsvImport()"
            class="h-8 px-4 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-xs font-medium text-slate-700 transition-colors"
          >
            Decline
          </button>
          <button
            id="csv-accept-btn"
            type="button"
            onclick="acceptCsvImport()"
            class="h-8 px-4 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium transition-colors"
          >
            Accept &amp; Sync Data
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="export-pdf-modal" onclick="if(event.target===this) closeExportPdfModal()" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-[2px] flex items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white shadow-xl overflow-hidden animate-fade">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200/80 bg-[#fbfcfd]">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Export as PDF</h3>
          <p id="export-pdf-target-label" class="text-[11px] text-slate-500 mt-0.5"></p>
        </div>
        <button type="button" onclick="closeExportPdfModal()" class="text-xs text-slate-400 hover:text-slate-700 p-1">✕</button>
      </div>

      <div class="p-5 space-y-4">
        <div class="space-y-2">
          <label class="block text-[11px] font-semibold text-slate-700">PDF Background Color</label>
          <div class="grid grid-cols-2 gap-2.5">
            <button
              type="button"
              id="export-pdf-mode-white"
              onclick="setExportPdfBgMode('white')"
              class="flex items-center gap-2.5 p-3 rounded-xl border-2 border-[#0f172a] bg-white text-left transition-colors"
            >
              <span class="w-5 h-5 rounded-md border border-slate-300 bg-white shrink-0"></span>
              <div>
                <div class="text-xs font-semibold text-slate-900">White</div>
                <div class="text-[10px] text-slate-500">#FFFFFF</div>
              </div>
            </button>
            <button
              type="button"
              id="export-pdf-mode-custom"
              onclick="setExportPdfBgMode('custom')"
              class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-[#fbfcfd] text-left transition-colors"
            >
              <span id="export-pdf-custom-swatch" class="w-5 h-5 rounded-md border border-slate-300 bg-[#0f172a] shrink-0"></span>
              <div>
                <div class="text-xs font-semibold text-slate-900">Custom Color</div>
                <div class="text-[10px] text-slate-500">Pick any shade</div>
              </div>
            </button>
          </div>
        </div>

        <div id="export-pdf-custom-controls" class="hidden rounded-xl border border-slate-200/80 bg-[#fbfcfd] p-3.5 space-y-2.5">
          <div class="flex items-center gap-2.5">
            <input
              id="export-pdf-color-picker"
              type="color"
              value="#0f172a"
              oninput="syncExportPdfCustomColor(this.value)"
              class="w-9 h-9 rounded-lg border border-slate-200 bg-white p-0.5 cursor-pointer shrink-0"
            />
            <input
              id="export-pdf-color-hex"
              type="text"
              value="#0f172a"
              placeholder="#0f172a"
              oninput="syncExportPdfCustomColor(this.value)"
              class="flex-1 h-9 px-3 text-xs font-mono bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:border-slate-400"
            />
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[10px] text-slate-500 mr-1">Presets:</span>
            <button type="button" onclick="syncExportPdfCustomColor('#f8fafc')" class="w-5 h-5 rounded border border-slate-300 bg-[#f8fafc]" title="Slate 50"></button>
            <button type="button" onclick="syncExportPdfCustomColor('#0f172a')" class="w-5 h-5 rounded border border-slate-300 bg-[#0f172a]" title="Slate 900"></button>
            <button type="button" onclick="syncExportPdfCustomColor('#1e1b4b')" class="w-5 h-5 rounded border border-slate-300 bg-[#1e1b4b]" title="Indigo Dark"></button>
            <button type="button" onclick="syncExportPdfCustomColor('#eff6ff')" class="w-5 h-5 rounded border border-slate-300 bg-[#eff6ff]" title="Soft Blue"></button>
            <button type="button" onclick="syncExportPdfCustomColor('#ecfdf5')" class="w-5 h-5 rounded border border-slate-300 bg-[#ecfdf5]" title="Soft Emerald"></button>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-4 border-t border-slate-200/80 bg-[#fbfcfd]">
        <button type="button" onclick="closeExportPdfModal()" class="h-8 px-3.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700">Cancel</button>
        <div class="flex items-center gap-2">
          <button type="button" onclick="copyCurrentExportWithBg()" class="h-8 px-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700">Copy Image</button>
          <button type="button" onclick="downloadCurrentExportPdf()" class="h-8 px-4 rounded-lg bg-[#0f172a] hover:bg-slate-800 text-white text-xs font-medium">Download PDF</button>
        </div>
      </div>
    </div>
  </div>

  <div id="export-toast" class="hidden fixed bottom-5 right-5 z-[60] px-4 py-2.5 rounded-xl bg-[#0f172a] text-white text-xs font-medium shadow-lg"></div>

  <script is:inline set:html={appJs}></script>
</body>
</html>
